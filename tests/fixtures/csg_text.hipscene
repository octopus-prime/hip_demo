hipscene 1
camera { position [0, 3, 12] target [0, 1, 0] half_view_height 0.4 }
room {
    size [8, 6, 10]
    floor color [0.7, 0.7, 0.7]
    ceiling color [0.7, 0.7, 0.7]
    back color [0.7, 0.7, 0.7]
    left color [0.7, 0.1, 0.1]
