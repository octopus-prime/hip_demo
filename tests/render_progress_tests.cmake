file(READ "${FIXTURES}/small.hipscene" source)
string(REPLACE [[file "triangle_ascii.ply"]] "file \"${FIXTURES}/triangle_ascii.ply\"" source "${source}")

foreach(mode IN ITEMS fixed adaptive single png config-png)
    set(samples 5)
    set(expected "Rendering: 0%;Rendering: 40%;Rendering: 80%;Rendering: 100%")
    set(sampling fixed)
    if(mode STREQUAL adaptive)
        set(sampling adaptive)
    elseif(mode STREQUAL single)
        set(samples 1)
        set(expected "Rendering: 0%;Rendering: 100%")
    endif()
    set(input "${OUTPUT_DIRECTORY}/progress-${mode}.hipscene")
    set(format BMP)
    set(extension bmp)
    if(mode MATCHES png)
        set(format PNG)
        set(extension png)
    endif()
    set(image "${OUTPUT_DIRECTORY}/progress-${mode}.${extension}")
    set(config "${OUTPUT_DIRECTORY}/progress-${mode}.cfg")
    set(arguments --output "${image}" --samples "${samples}" --sampling "${sampling}"
        --width 17 --height 9 --batch-size 2 --min-samples 2 --specular-min-samples 2)
    if(mode STREQUAL config-png)
        file(WRITE "${config}" "output = ${image}\nwidth = 17\nheight = 9\nsampling = fixed\nsamples = 3\nbatch-size = 2\n")
        set(arguments --config "${config}" --samples 5 --batch-size 2)
    endif()
    file(WRITE "${input}" "${source}")
    execute_process(COMMAND "${RENDERER}" ${arguments} --scene "${input}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    file(REMOVE "${input}" "${config}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "${mode} render failed: ${result}\n${output}\n${errors}")
    endif()
    if(NOT EXISTS "${image}")
        message(FATAL_ERROR "${mode} render did not produce an image")
    endif()
    if(format STREQUAL PNG)
        file(READ "${image}" signature LIMIT 8 HEX)
        file(READ "${image}" dimensions OFFSET 16 LIMIT 8 HEX)
        if(NOT signature STREQUAL "89504e470d0a1a0a" OR NOT dimensions STREQUAL "0000001100000009")
            message(FATAL_ERROR "${mode} output is not a 17x9 PNG")
        endif()
    else()
        file(READ "${image}" dimensions OFFSET 18 LIMIT 8 HEX)
        if(NOT dimensions STREQUAL "11000000f7ffffff")
            message(FATAL_ERROR "${mode} output is not a 17x9 top-down BMP")
        endif()
    endif()
    if(mode STREQUAL png)
        file(SHA256 "${image}" cli_png)
    elseif(mode STREQUAL config-png)
        file(SHA256 "${image}" config_png)
        if(NOT config_png STREQUAL cli_png)
            message(FATAL_ERROR "Equivalent config and CLI render options changed the rendered image")
        endif()
    endif()
    file(REMOVE "${image}")
    string(REGEX MATCHALL "Rendering: [0-9]+%" updates "${output}")
    if(NOT updates STREQUAL expected)
        message(FATAL_ERROR "${mode} progress: expected ${expected}, got ${updates}\n${output}")
    endif()
    string(FIND "${output}" "Rendering: 100%" completed)
    string(FIND "${output}" "Copying image to CPU and writing ${format}..." saving)
    if(saving LESS completed)
        message(FATAL_ERROR "${mode} saving status must follow completed rendering\n${output}")
    endif()
endforeach()

execute_process(COMMAND "${RENDERER}" --output "${OUTPUT_DIRECTORY}/unsupported-image.jpg" --samples 1
    --scene "${FIXTURES}/small.hipscene"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(result STREQUAL "0" OR NOT errors MATCHES "Unsupported image extension" OR output MATCHES "Rendering on")
    message(FATAL_ERROR "Unsupported output extension must fail before GPU setup\n${output}\n${errors}")
endif()

execute_process(COMMAND "${RENDERER}" --help --scene nonexistent.hipscene --config nonexistent.cfg
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result STREQUAL "0" OR NOT output MATCHES "--save-config" OR output MATCHES "Rendering on")
    message(FATAL_ERROR "Help must succeed without loading files or the GPU\n${output}\n${errors}")
endif()

set(config "${OUTPUT_DIRECTORY}/saved-render-options.cfg")
execute_process(COMMAND "${RENDERER}" --scene nonexistent.hipscene --width 23 --height 11
    --samples 7 --device 2147483647 --save-config "${config}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
if(NOT result STREQUAL "0" OR NOT EXISTS "${config}" OR output MATCHES "Rendering on")
    message(FATAL_ERROR "Saving config must not load scenes or initialize a GPU\n${output}\n${errors}")
endif()
file(READ "${config}" saved)
file(REMOVE "${config}")
if(NOT saved MATCHES "width = 23" OR NOT saved MATCHES "height = 11" OR NOT saved MATCHES "samples = 7")
    message(FATAL_ERROR "Saved config did not contain effective CLI values")
endif()
