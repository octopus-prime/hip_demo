hipscene 1

image {
    size [1280, 720]
    output "text.bmp"
}
sampling adaptive {
    min 32
    specular_min 64
    max 256
    batch 8
    relative_error 0.05
    brightness_floor 0.05
}
camera {
    position [3, 2.5, 8]
    target [0, 1, 0]
    half_view_height 0.24
}
room {
    size [6, 4, 5]
    floor tiles_detail
    ceiling color [0.75, 0.75, 0.75]
    back marble_detail
    left color [0.72, 0.10, 0.10]
    right color [0.10, 0.65, 0.16]
}
material gold = metal [0.92, 0.58, 0.22] roughness 0.08
material blue = phong [0.12, 0.28, 0.82]

light ceiling_rectangle {
    center [0, -0.4]
    size [1.8, 1.4]
    radiance [12, 11.5, 10.5]
}
text {
    font "C:\\Windows\\Fonts\\arial.ttf"
    value "HIP RT"
    size 1.2
    depth 0.35
    position [-2, 0.02, 0]
    material gold
}
text {
    font "C:\\Windows\\Fonts\\arial.ttf"
    value "Bezier"
    size 0.8
    depth 0.2
    position [-1.4, 1.3, -0.7]
    material blue
}
