    sphere { center [-0.4, 0, 0] radius 0.8 }
    sphere { center [0.4, 0, 0] radius 0.8 }
} }
prototype lens = csg { material glass intersection {
    sphere { center [-0.3, 0, 0] radius 1 }
    sphere { center [0.3, 0, 0] radius 1 }
} }
prototype drilled = csg { material mandelbrot difference {
